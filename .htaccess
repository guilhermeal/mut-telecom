# MUT Telecom — regras gerais do site (Apache + mod_rewrite)

# Nunca listar o conteúdo de um diretório sem index
Options -Indexes

# HSTS: instrui o navegador a nunca mais tentar HTTP neste domínio pelo
# tempo abaixo (1 dia), mesmo que o usuário digite "http://" ou clique num
# link antigo — evita completamente a primeira requisição insegura em
# visitas futuras. max-age começa conservador (86400s = 1 dia); depois de
# confirmar que o HTTPS está estável em produção por um tempo, subir para
# 31536000 (1 ano) + preload é o recomendado.
# <IfModule mod_headers.c>
#    Header always set Strict-Transport-Security "max-age=86400; includeSubDomains"
# </IfModule>

# Bloqueia acesso direto a qualquer arquivo "oculto" (.env, .git, .htaccess etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Documentação do repositório (README, CHANGELOG, instruções de projeto) não é
# conteúdo do site — nunca deve ser servida por HTTP.
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

RewriteEngine On

# Bloqueia qualquer acesso à pasta .git (e seu conteúdo), caso ela seja
# publicada por engano — o FilesMatch "^\." acima só pega arquivos soltos,
# não o que está dentro de uma pasta com nome iniciado por ponto.
RewriteRule ^\.git(/|$) - [F,L]

# Força HTTPS em qualquer acesso HTTP (301, permanente) — exceto em ambiente
# local (localhost/127.0.0.1), onde normalmente não há certificado configurado.
# %{HTTPS} cobre o caso comum (mod_ssl direto); X-Forwarded-Proto cobre
# hospedagens atrás de proxy/load balancer, onde a conexão com o Apache em si
# é HTTP mas o cliente usou HTTPS até o proxy — sem essa segunda condição, o
# site entraria em loop de redirecionamento nesse cenário.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# /index ou /index.php -> raiz (evita URL duplicada para a home)
RewriteCond %{THE_REQUEST} \s/(\S*/)?index(\.php)?[?\s] [NC]
RewriteRule ^ /%1 [R=301,L]

# Qualquer acesso direto a /pagina.php -> redireciona (301) para /pagina
# (exceto /api/*, que é sempre chamado com a extensão .php via POST/fetch —
# redirecionar quebraria o corpo da requisição em alguns clientes/proxies)
RewriteCond %{THE_REQUEST} \s/+([^.\s]+)\.php[?\s] [NC]
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^ /%1 [R=301,L]

# Resolve internamente /pagina para o arquivo físico pagina.php, sem trocar a URL.
# Não se aplica quando a URL já é um arquivo .php existente (ex.: /api/contato.php)
# — nesse caso o Apache já serve o arquivo diretamente, sem precisar de rewrite.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]
