# Copie este arquivo para ".env" (nunca commitado — veja .gitignore) e
# preencha com as credenciais reais fornecidas pela hospedagem.
# O formulário de contato (api/contato.php) lê estas variáveis em runtime.

# --- Servidor SMTP ---
MAIL_SMTP_HOST=
# Porta 465 = SSL implícito (SMTPS) | Porta 587 = STARTTLS (mais comum hoje)
MAIL_SMTP_PORT=587
# "ssl" para porta 465, "tls" para porta 587
MAIL_SMTP_SECURE=tls

# --- Autenticação SMTP ---
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# --- Remetente (From) ---
# Conta usada para autenticar/enviar. Deve ser uma caixa real e autorizada
# no domínio (evita bloqueio por SPF/DKIM). Pode ser igual ou diferente do
# destinatário abaixo.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="MUT Telecom — Site"

# --- Destinatário final ---
# Para onde as mensagens do formulário de contato são entregues.
MAIL_TO_ADDRESS=contato@muttelecom.com.br
MAIL_TO_NAME="MUT Telecom"
